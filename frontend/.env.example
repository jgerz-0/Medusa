# Base URL for the controller API; default assumes local controller development.
CONTROLLER_API_BASE_URL=http://localhost:8000
# API key issued by the controller; update to match the credential configured for the dashboard agent.
CONTROLLER_API_KEY=demo-controller-api-key
# JWT issued by the controller when using bearer auth; override with the signed token from the controller.
CONTROLLER_JWT=demo-controller-jwt
# Default HTTP Basic auth credentials for accessing the dashboard during development.
DASHBOARD_BASIC_USER=analyst
DASHBOARD_BASIC_PASSWORD=analyst
