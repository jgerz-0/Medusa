# Base URL for the FastAPI controller
CONTROLLER_API_BASE_URL=http://127.0.0.1:8000

# API key issued by the controller. Required for server-side fetches.
CONTROLLER_API_KEY=replace-me

# Optional JWT issued by the controller when RBAC is enabled.
CONTROLLER_JWT=

# Dashboard access control (Basic auth). Username defaults to `api` if unset.
DASHBOARD_BASIC_USER=analyst
DASHBOARD_BASIC_PASSWORD=replace-me
