# Base URL for the controller API; default assumes local controller development.
CONTROLLER_API_BASE_URL=http://localhost:8000

# PKCE OIDC configuration used by the analyst console.
MEDUSA_SESSION_SECRET=replace-with-32-byte-random
MEDUSA_OIDC_ISSUER=https://changeme.example.com/realms/medusa
MEDUSA_OIDC_CLIENT_ID=medusa-frontend
MEDUSA_OIDC_CLIENT_SECRET=replace-me
MEDUSA_OIDC_AUDIENCE=medusa-controller
MEDUSA_OIDC_SCOPES=openid profile email offline_access

# Optional overrides when your IdP does not expose standard discovery metadata.
# MEDUSA_OIDC_AUTHORIZATION_ENDPOINT=
# MEDUSA_OIDC_TOKEN_ENDPOINT=
# MEDUSA_OIDC_USERINFO_ENDPOINT=

# Session hardening knobs.
# MEDUSA_SESSION_TTL_SECONDS=604800
# MEDUSA_OIDC_TOKEN_SKEW_SECONDS=60
# MEDUSA_OIDC_REQUEST_TIMEOUT_SECONDS=10

# Automation credentials (do not use for human analysts).
CONTROLLER_API_KEY=
CONTROLLER_JWT=
