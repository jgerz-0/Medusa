# Compose project metadata
COMPOSE_PROJECT_NAME=medusa

# Postgres configuration for the controller
MEDUSA_POSTGRES_USER=medusa
MEDUSA_POSTGRES_PASSWORD=medusa
MEDUSA_POSTGRES_DB=medusa
MEDUSA_POSTGRES_PORT=5432

# Redis configuration
MEDUSA_REDIS_PORT=6379

# MinIO object storage defaults
MINIO_ROOT_USER=medusaadmin
MINIO_ROOT_PASSWORD=medusaadmin123
MINIO_SITE_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Qdrant vector database ports
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Controller service configuration
MEDUSA_CONTROLLER_PORT=8000
MEDUSA_DATABASE_URL=postgresql+psycopg2://medusa:medusa@postgres:5432/medusa
MEDUSA_REDIS_URL=redis://redis:6379/0
MEDUSA_NUCLEI_QUEUE_CHANNEL=queues:nuclei:jobs
MEDUSA_ZAP_QUEUE_CHANNEL=queues:zap:jobs
MEDUSA_SQLMAP_QUEUE_CHANNEL=queues:sqlmap:jobs
MEDUSA_CVE_ENRICHMENT_QUEUE_CHANNEL=queues:enrichment:cve
MEDUSA_BINARY_PREPROCESS_QUEUE_CHANNEL=queues:binary:preprocess
MEDUSA_BINARY_STATIC_ANALYSIS_QUEUE_CHANNEL=queues:binary:static-analysis
MEDUSA_BINARY_FUZZING_QUEUE_CHANNEL=queues:binary:fuzzing
MEDUSA_NUCLEI_CALLBACK_TOKEN=local-dev-nuclei-callback
MEDUSA_ZAP_CALLBACK_TOKEN=local-dev-zap-callback
MEDUSA_SQLMAP_CALLBACK_TOKEN=local-dev-sqlmap-callback
MEDUSA_ENRICHMENT_CALLBACK_TOKEN=local-dev-enrichment-callback
MEDUSA_BINARY_STATIC_ANALYSIS_CALLBACK_TOKEN=local-dev-binary-static-callback
MEDUSA_BINARY_FUZZING_CALLBACK_TOKEN=local-dev-binary-fuzzing-callback
MEDUSA_CVE_ENRICHMENT_QDRANT_URL=http://qdrant:6333
MEDUSA_CVE_ENRICHMENT_QDRANT_COLLECTION=medusa-advisories
MEDUSA_JWT_SECRET=local-dev-jwt-secret-change-me
MEDUSA_API_KEYS=frontend-dev-key,nuclei-smoke-key
# API keys are generated during container bootstrap by scripts/seed_principals.py

# Frontend analyst console defaults
MEDUSA_FRONTEND_PORT=3000
CONTROLLER_API_BASE_URL=http://controller:8000
CONTROLLER_JWT=
DASHBOARD_BASIC_USER=analyst
DASHBOARD_BASIC_PASSWORD=analyst
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# Nuclei worker configuration
REDIS_URL=redis://redis:6379/0
NUCLEI_QUEUE_KEY=queues:nuclei:jobs
NUCLEI_DEAD_LETTER_KEY=queues:nuclei:dead
NUCLEI_CALLBACK_TOKEN=local-dev-nuclei-callback
NUCLEI_CALLBACK_VERIFY_TLS=false
NUCLEI_CALLBACK_TIMEOUT=30
NUCLEI_POLL_TIMEOUT=2
NUCLEI_MAX_RETRIES=3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=medusaadmin
S3_SECRET_KEY=medusaadmin123
NUCLEI_ARTIFACT_BUCKET=
NUCLEI_ARTIFACT_PREFIX=nuclei/

# Binary preprocess worker configuration
BINARY_PREPROCESS_QUEUE_KEY=queues:binary:preprocess
BINARY_PREPROCESS_DEAD_LETTER_KEY=queues:binary:preprocess:dead
BINARY_METADATA_BUCKET=binary-metadata
BINARY_METADATA_PREFIX=preprocess/metadata/
S3_ACCESS_KEY_ID=medusaadmin
S3_SECRET_ACCESS_KEY=medusaadmin123
AWS_DEFAULT_REGION=us-east-1

# Binary fuzzing worker configuration
BINARY_FUZZING_QUEUE_KEY=queues:binary:fuzzing
BINARY_FUZZING_DEAD_LETTER_KEY=queues:binary:fuzzing:dead
BINARY_FUZZING_BUCKET=
BINARY_FUZZING_PREFIX=analysis/fuzzing/
BINARY_FUZZING_POLL_TIMEOUT=5
BINARY_FUZZING_MAX_ATTEMPTS=3
BINARY_FUZZING_RUNTIME=docker
BINARY_FUZZING_RUNTIME_FLAGS=
BINARY_FUZZING_AFL_IMAGE=docker.io/medusa/afl:latest
BINARY_FUZZING_LIBFUZZER_IMAGE=docker.io/medusa/libfuzzer:latest
BINARY_FUZZING_AFL_COMMAND=/opt/medusa/run_afl
BINARY_FUZZING_LIBFUZZER_COMMAND=/opt/medusa/run_libfuzzer
BINARY_FUZZING_ENABLE_AFL=1
BINARY_FUZZING_ENABLE_LIBFUZZER=1
BINARY_FUZZING_MAX_DURATION=900
BINARY_FUZZING_CALLBACK_TOKEN=local-dev-binary-fuzzing-callback

# ZAP worker configuration
ZAP_QUEUE_KEY=queues:zap:jobs
ZAP_DEAD_LETTER_KEY=queues:zap:dead
ZAP_CALLBACK_TOKEN=local-dev-zap-callback
ZAP_CALLBACK_VERIFY_TLS=false
ZAP_CALLBACK_TIMEOUT=30
ZAP_POLL_TIMEOUT=2
ZAP_MAX_RETRIES=3
ZAP_WORK_DIR=/tmp/zap

# SQLMap worker configuration
SQLMAP_QUEUE_KEY=queues:sqlmap:jobs

# Ticketing worker configuration
TICKETING_JIRA_BASE_URL=https://jira.example.com
TICKETING_JIRA_USER=analyst@example.com
TICKETING_JIRA_API_TOKEN=changeme
TICKETING_GITHUB_BASE_URL=https://api.github.com
TICKETING_GITHUB_TOKEN=
TICKETING_POLL_INTERVAL=5
TICKETING_BATCH_SIZE=10
TICKETING_MAX_ATTEMPTS=3
TICKETING_HTTP_TIMEOUT=10
SQLMAP_DEAD_LETTER_KEY=queues:sqlmap:dead
SQLMAP_CALLBACK_TOKEN=local-dev-sqlmap-callback
SQLMAP_CALLBACK_VERIFY_TLS=false
SQLMAP_CALLBACK_TIMEOUT=30
SQLMAP_POLL_TIMEOUT=2

SQLMAP_MAX_RETRIES=3
SQLMAP_WORK_DIR=/tmp/sqlmap
# CVE enrichment worker configuration
CVE_ENRICHMENT_QUEUE_KEY=queues:enrichment:cve
CVE_ENRICHMENT_RESULT_QUEUE_KEY=queues:enrichment:cve:results
CVE_ENRICHMENT_ERROR_QUEUE_KEY=queues:enrichment:cve:errors
CVE_ENRICHMENT_MAX_ATTEMPTS=3
CVE_ENRICHMENT_RETRY_BACKOFF_SECONDS=2
CVE_ENRICHMENT_QUEUE_POLL_TIMEOUT=5
CVE_ENRICHMENT_HTTP_TIMEOUT=30
CVE_ENRICHMENT_QDRANT_URL=http://qdrant:6333
CVE_ENRICHMENT_QDRANT_COLLECTION=medusa-advisories
CVE_ENRICHMENT_QDRANT_API_KEY=
CVE_ENRICHMENT_QDRANT_TIMEOUT=5
CVE_ENRICHMENT_QDRANT_VECTOR_SIZE=64

# Smoke test helper defaults
SMOKE_TEST_TEMPLATE_PATH=/app/templates/smoke-test.yaml
SMOKE_TEST_TARGET_URL=http://controller:8000
SMOKE_TEST_CALLBACK_URL=http://controller:8000/internal/nuclei/callback
