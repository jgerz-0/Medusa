# Global compose defaults
COMPOSE_PROJECT_NAME=medusa

# Postgres (controller persistence)
MEDUSA_POSTGRES_USER=medusa
MEDUSA_POSTGRES_PASSWORD=medusa
MEDUSA_POSTGRES_DB=medusa
MEDUSA_POSTGRES_PORT=5432
MEDUSA_DATABASE_URL=postgresql+psycopg2://medusa:medusa@postgres:5432/medusa
DATABASE_URL=postgresql+psycopg2://medusa:medusa@postgres:5432/medusa

# Redis (queue + cache)
MEDUSA_REDIS_PORT=6379
MEDUSA_REDIS_URL=redis://redis:6379/0

# MinIO (artifact storage)
MINIO_ROOT_USER=medusaadmin
MINIO_ROOT_PASSWORD=medusaadmin123
MINIO_SITE_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Qdrant (vector enrichment)
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Controller service
MEDUSA_CONTROLLER_PORT=8000
MEDUSA_JWT_SECRET=local-dev-jwt-secret
MEDUSA_API_KEYS=frontend-dev-key,nuclei-smoke-key
MEDUSA_NUCLEI_QUEUE_CHANNEL=queues:nuclei:jobs
MEDUSA_NUCLEI_CALLBACK_TOKEN=local-dev-nuclei-callback

# Frontend dashboard
MEDUSA_FRONTEND_PORT=3000
CONTROLLER_API_BASE_URL=http://controller:8000
CONTROLLER_API_KEY=frontend-dev-key
CONTROLLER_JWT=
DASHBOARD_BASIC_USER=analyst
DASHBOARD_BASIC_PASSWORD=analyst
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# Nuclei worker defaults
NUCLEI_QUEUE_KEY=queues:nuclei:jobs
NUCLEI_DEAD_LETTER_KEY=queues:nuclei:dead
NUCLEI_POLL_TIMEOUT=2
NUCLEI_MAX_RETRIES=3
NUCLEI_CALLBACK_TOKEN=local-dev-nuclei-callback
NUCLEI_CALLBACK_VERIFY_TLS=false
NUCLEI_CALLBACK_TIMEOUT=30

# Optional artifact upload wiring (disabled by default)
NUCLEI_ARTIFACT_BUCKET=
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=medusaadmin
S3_SECRET_KEY=medusaadmin123

